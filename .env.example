# Copy this file to .env and fill in real values. Never commit .env.

PORT=3000

# Admin dashboard (protects GET /admin.html and GET /api/* list endpoints)
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# Paystack secret key — used server-side to verify a payment reference before
# an order is recorded as paid. Get it from
# https://dashboard.paystack.com/#/settings/developer (starts with sk_).
# If left blank, orders are still recorded but flagged "unverified" so you
# know not to fulfill them until you've checked the payment yourself.
PAYSTACK_SECRET_KEY=

# Optional: email notifications for new orders/messages. If any of these are
# left blank, the server just skips sending email and relies on the admin
# dashboard instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL_TO=support@amulreefashion.com
NOTIFY_EMAIL_FROM=
